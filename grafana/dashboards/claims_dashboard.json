          "refId": "A"
        },
        {
          "expr": "sum(rate(agent_tool_calls_per_run_sum[5m])) / sum(rate(agent_tool_calls_per_run_count[5m]))",
          "legendFormat": "tool calls / run",
          "refId": "B"
        }
      ]
