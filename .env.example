# Copy this file to .env (Windows: copy .env.example .env) and edit as needed.
# Never commit .env. No credentials, endpoints or model names are hard-coded anywhere (D4).
# Note: do not put comments on the same line as a value; Docker reads them as part of the value.

# ---------------- Application ----------------
APP_NAME=AirPassengerClaimTriage
APP_ENV=development
LOG_LEVEL=INFO

# ---------------- Queues / Redis ----------------
# REDIS_HOST is set to "redis" by docker-compose; this value is only for running outside Docker.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CLAIM_QUEUE_NAME=claim_processing_queue
REASONING_QUEUE_NAME=claim_reasoning_queue

# ---------------- Caching & rate limiting (D7) ----------------
# Set CACHE_ENABLED=false to measure p95 and cost without the whole-run cache.
CACHE_ENABLED=true
RESULT_CACHE_TTL=86400
CLIENT_RATE_LIMIT_RPS=10
CLIENT_RATE_LIMIT_BURST=20

# ---------------- Agent loop bounds (A1) ----------------
MAX_AGENT_STEPS=16
MAX_AGENT_TOOL_CALLS=10
AGENT_WALL_CLOCK_TIMEOUT_SECONDS=45

# ---------------- Retrieval (L1) ----------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_SIMILARITY_THRESHOLD=0.25

# ---------------- LLM provider (A5, D4, D6) ----------------
# stub-service = the llm-stub container: fixed responses after STUB_DELAY_SECONDS, over HTTP
#                like a real provider. Default; use it for load tests (D6) and demo item 8.
# stub   = in-process stub (no HTTP), used by the unit tests.
# groq   = free tier, OpenAI-compatible. Key: https://console.groq.com/keys
#          e.g. LLM_MODEL=openai/gpt-oss-20b   (Groq retired the Llama 3.x models in Aug 2026)
# gemini = free tier, OpenAI-compatible. Key: https://aistudio.google.com/apikey
#          LLM_MODEL = a current "flash" model id from the AI Studio model list
# ollama = local model (needs a powerful machine), e.g. LLM_MODEL=llama3.1
# openai = any OpenAI-compatible endpoint given in LLM_API_BASE
LLM_PROVIDER=stub-service
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=15
STUB_DELAY_SECONDS=0.6
STUB_JITTER_SECONDS=0.2
STUB_FAILURE_RATE=0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---------------- Observability (D5, L6) ----------------
# OTEL_EXPORTER_OTLP_ENDPOINT is set to the jaeger service by docker-compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LIVE_EVAL_SAMPLE_RATE=0.25

# ---------------- Grafana ----------------
GRAFANA_ADMIN_PASSWORD=admin

# ---------------- SLO (D6) ----------------
SLO_P95_LATENCY_SECONDS=5.0
