# Application Configuration
APP_NAME=AirPassengerClaimTriage
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Worker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CLAIM_QUEUE_NAME=claim_processing_queue
RESULT_CACHE_TTL=86400

# Rate Limiting & Cost Limits
CLIENT_RATE_LIMIT_RPS=10
CLIENT_RATE_LIMIT_BURST=20
MAX_AGENT_STEPS=8
MAX_AGENT_TOOL_CALLS=10
AGENT_WALL_CLOCK_TIMEOUT_SECONDS=45

# Vector Index Configuration
VECTOR_INDEX_DIR=./data/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.45

# LLM Provider Configuration
LLM_PROVIDER=stub  # Options: stub, openai, anthropic, ollama
LLM_MODEL=stub-deterministic-v1
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=15
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Observability
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=claim-triage-service

# SLO Targets
SLO_P95_LATENCY_SECONDS=5.0
